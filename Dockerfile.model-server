# Model server image for classifier, NER, and summarization endpoints.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install system packages needed by ML dependencies.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency metadata first.
COPY pyproject.toml ./

# Install CPU-only PyTorch and model dependencies during image build.
RUN pip install --upgrade pip \
    && pip install torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install -e ".[model]"

# Copy project code.
COPY . .

# Run model server.
CMD ["uvicorn", "model_server.main_dev:app", "--host", "0.0.0.0", "--port", "8001"]