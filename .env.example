# Vault dev token
VAULT_ROOT_TOKEN=root

# App ports
API_PORT=8000
MODEL_SERVER_PORT=8001
STREAMLIT_PORT=8501

# Infrastructure ports
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
VAULT_PORT=8200

# Vault host.
# Use localhost when running scripts from your laptop.
# Docker Compose overrides this to "vault" for containers.
VAULT_HOST=localhost

DATABASE_SYNC_URL=postgresql+psycopg://maintainer:maintainer@localhost:5432/maintainers_copilot